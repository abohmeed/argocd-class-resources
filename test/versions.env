# Pinned versions. CI runs the matrix across ARGOCD_VERSIONS; everything else is a single pin.
# Every one of these was verified against official sources on 2026-09-20.

# Argo CD support window = latest three minors. The suite runs against all three.
ARGOCD_VERSIONS="v3.3 v3.4 v3.5"
ARGOCD_PIN="v3.5.3"

K3S_CHANNEL="stable"                        # v1.37.0+k3s1 at time of writing
GATEWAY_API_VERSION="v1.6.1"                # standard channel
CERT_MANAGER_VERSION="v1.21.2"
SEALED_SECRETS_VERSION="v0.40.0"            # github.com/bitnami/sealed-secrets (moved from bitnami-labs)
EXTERNAL_SECRETS_VERSION="v2.11.0"
OPENBAO_CHART_REPO="https://openbao.github.io/openbao-helm"
SOPS_VERSION="v3.13.3"
AGE_VERSION="v1.3.2"
ARGO_ROLLOUTS_VERSION="v1.10.0"
ROLLOUTS_GATEWAY_PLUGIN_VERSION="v0.17.0"   # argoproj-labs; Gateway API routing is a PLUGIN, not native
ROLLOUTS_UI_EXTENSION_VERSION="v0.4.0"      # requires Argo CD v3.5+
IMAGE_UPDATER_VERSION="v1.1.1"              # argoproj-labs
POSTGRES_IMAGE="postgres:18.6"              # official image; NEVER a Bitnami chart
HTTP_ECHO_IMAGE="hashicorp/http-echo:1.0"
